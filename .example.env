# ==================================================
# Core Application
# ==================================================
APP_NAME="tmdb"
APP_SECRET="supersecret"

# ==================================================
# Infrastructure — Docker Images
# ==================================================
# Base images used across all services. Bump these to upgrade components.
ALPINE_IMAGE="alpine:3.23"
BUN_IMAGE="oven/bun:1.3-alpine"
BUSYBOX_IMAGE="busybox:musl"

# Observability stack
GF_IMAGE_RENDERER_IMAGE="grafana/grafana-image-renderer:v5.8.2"
GF_LOKI_IMAGE="grafana/loki:3.7.2"
GRAFANA_IMAGE="grafana/grafana:12.3-ubuntu"
PROMETHEUS_IMAGE="prom/prometheus:v3-busybox"
VECTOR_IMAGE="timberio/vector:0.54.0-alpine"

# Data pipeline
CUE_IMAGE="cuelang/cue:0.16.1"
GOMPLATE_IMAGE="hairyhenderson/gomplate:v5.0-alpine"
RD_CONNECT_IMAGE="redpandadata/connect:4.83.0"
REDPANDA_IMAGE="redpandadata/redpanda:v25.3.10"

# ML / embeddings
HF_TEI_IMAGE="ghcr.io/huggingface/text-embeddings-inference:1.9.2"

# Proxy / UI
NGINX_IMAGE="nginx:1.29-alpine"
PGADMIN_IMAGE="dpage/pgadmin4:9.11"
KAFKA_UI_IMAGE="kafbat/kafka-ui:afc9c91"
RD_CONSOLE_IMAGE="redpandadata/console:v3.6.0"

# Database & pooling
POSTGRES_IMAGE="supabase/postgres:17.6.1.072"
PGBOUNCER_IMAGE="edoburu/pgbouncer:v1.25.1-p0"
POSTGRES_EXPORTER_IMAGE="prometheuscommunity/postgres-exporter:v0.19.1"
PGBOUNCER_EXPORTER_IMAGE="prometheuscommunity/pgbouncer-exporter:v0.12.0"

# ==================================================
# Infrastructure — Traefik (External Reverse Proxy)
# ==================================================
# See: https://github.com/teyfix/traefik
# Only required if you use teyfix/traefik for TLS termination.

# Unique prefix for router/service/middleware names to avoid collisions
# when running multiple stacks.
TRAEFIK_SERVICE_PREFIX="$APP_NAME"

# Base domain for all Traefik routers.
# Results in: grafana.tmdb.127-0-0-1.sslip.io, kafka-ui.tmdb.127-0-0-1.sslip.io, etc.
TRAEFIK_BASE_DOMAIN="${TRAEFIK_SERVICE_PREFIX}.127-0-0-1.sslip.io"

# Certificate resolver (Step CA / ACME)
TRAEFIK_ACME_RESOLVER="stepca"

# Entrypoints
TRAEFIK_TCP_ENTRYPOINT="shared"      # TCP (Kafka broker)
TRAEFIK_HTTPS_ENTRYPOINT="websecure" # HTTPS (all web UIs)

# ==================================================
# Infrastructure — Internal nginx Proxy
# ==================================================
# Fallback HTTP proxy (port 8000) used when Traefik is NOT running.
# Routes by Host header. See services/nginx/README.md for subdomain mapping.
NGINX_PORT="8000"

# ==================================================
# Infrastructure — Kafka (Redpanda)
# ==================================================
KAFKA_BROKERS="kafka.lokal:9092"

# Topic defaults
KAFKA_NUM_PARTITIONS="3"
KAFKA_MAX_MESSAGE_BYTES="104857600"
KAFKA_CLEANUP_POLICY="compact"
KAFKA_COMPRESSION_TYPE="zstd"

# ==================================================
# Infrastructure — PostgreSQL
# ==================================================
# Initial database created on first boot.
POSTGRES_DB="tmdb"

#! IMPORTANT:
#! Username must be `supabase_admin` for Supabase init scripts to work correctly.
POSTGRES_USER="supabase_admin"
POSTGRES_PASSWORD="$APP_SECRET"

# Application-level non-root user (used by pipeline workers)
PG_USER="$APP_NAME"
PG_PASSWORD="$APP_SECRET"
PG_SCHEMA="$APP_NAME"

# Connection strings (built from vars above — do not edit directly)
POSTGRES_URL="postgresql://${PG_USER}:${PG_PASSWORD}@pgbouncer.lokal:5432/${PG_SCHEMA}?sslmode=disable"
POSTGRES_ADMIN_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres.lokal:5432/${POSTGRES_DB}"

# ==================================================
# Infrastructure — PgBouncer
# ==================================================
PGBOUNCER_USER="pgbouncer_admin"
PGBOUNCER_PASS="$APP_SECRET"

# ==================================================
# Infrastructure — pgAdmin
# ==================================================
PGADMIN_DEFAULT_EMAIL="$APP_NAME@$TRAEFIK_BASE_DOMAIN"
PGADMIN_DEFAULT_PASSWORD="$APP_SECRET"

# ==================================================
# Infrastructure — Grafana
# ==================================================
GF_SECURITY_ADMIN_PASSWORD="$APP_SECRET"

# ==================================================
# Pipeline — TMDB API Credentials
# ==================================================
# TMDB_API_KEY  — Legacy v3 API key (query-param auth). Not used by the
#                   pipeline; kept for backward compatibility / manual use.
# TMDB_API_SECRET — Bearer token (v3/v4). Used by the enrich worker as
#                   Authorization: Bearer ${TMDB_API_SECRET}
TMDB_API_KEY="********************************"
TMDB_API_SECRET="********************.****************************************.********************************"

# ==================================================
# Pipeline — Text Embeddings (TEI / HuggingFace)
# ==================================================
EMBEDDING_MODEL="BAAI/bge-large-en-v1.5"
EMBEDDING_DIMENSIONS="1024"

# Maximum embedding dimensions. Used to determine padding for embedding
# vectors (must be >= EMBEDDING_DIMENSIONS).
EMBEDDING_DIMENSIONS_MAX="2048"

# ==================================================
# Pipeline — Resource Limits
# ==================================================
# These map to Docker Compose `deploy.resources.limits`.

# Redpanda (Kafka broker) — CPU-intensive under connection burst and
# partition rebalance.
REDPANDA_RESOURCE_CPU="4"
REDPANDA_RESOURCE_MEM="4G"

# PostgreSQL — I/O bound, benefits more from memory than CPU.
POSTGRES_RESOURCE_CPU="4"
POSTGRES_RESOURCE_MEM="4G"
# Shared memory — should be roughly half of POSTGRES_RESOURCE_MEM.
POSTGRES_RESOURCE_SHM="2G"

# Normalize — fan-out heavy, processes all topics in parallel.
NORMALIZE_RESOURCE_CPU="4"
NORMALIZE_RESOURCE_MEM="4G"

# Ingest — heaviest service, 50+ streams × broker + PG connections.
INGEST_RESOURCE_CPU="8"
INGEST_RESOURCE_MEM="8G"

# Ingest sql_insert tuning (per-output-stream connection pool)
INGEST_MAX_IN_FLIGHT="64"
INGEST_CONN_MAX_OPEN="3"
INGEST_CONN_MAX_IDLE="2"
INGEST_CONN_MAX_LIFE_TIME="2m"
