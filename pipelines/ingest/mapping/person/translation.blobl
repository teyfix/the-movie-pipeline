root = this.data.translations.
  map_each(t -> t.
    with("name", "biography").
    key_values().
    filter(kv -> ![0, null, ""].contains(kv.value)).
    map_each(kv -> t.
      with("iso_3166_1", "iso_639_1").
      assign({
        "field": kv.key,
        "value": kv.value.string(),
        "primary": t.primary,
        "person_id": this.data.id,
        "version_ts": this.meta.ts,
      })
    )
  ).
  flatten()
