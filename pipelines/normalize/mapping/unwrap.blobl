#? unwrap `lists.results`, `keywords.keywords` etc.
root = this.data.map_each(kv -> if kv.value.exists("results") { kv.value.results } else {
  if kv.value.exists(kv.key) { kv.value.get(kv.key) } else { kv.value }
})

let props = root.keys()

# === Movie, Tv Series, Person ===
root.translations = if $props.contains("translations") {
  root.translations.or([]).map_each(tr -> tr.without("data").assign(tr.data))
}

# === Movie, Tv Series ===
#? Tv Series' `alternative_titles` is in shape of `{results: []}`
#? which is handled above in first step
#? This is a no-op for Tv Series (hence: `or(root.alternative_titles)`)
root.alternative_titles = if $props.contains("alternative_titles") {
  root.alternative_titles.titles.or(root.alternative_titles)
}

#? Flatten reviews' `author_details`
root.reviews = if $props.contains("reviews") {
  root.reviews.or([]).
    map_each(r -> r.
      without("author_details").
      assign(r.author_details.map_each_key(k -> "author_" + k))
    )
}

# === Movie ===
#? Flatten nested `release_dates`
#? [{iso_3166_1: US, release_dates: [{...}]}]
root.release_dates = if $props.contains("release_dates") {
  root.release_dates.or([]).
    map_each(rg -> rg.
      release_dates.
      map_each(rd -> rg.without("release_dates").assign(rd))
    ).flatten()
}

# === Preserve Original Structure ===
root = this.assign({ "data": root })
