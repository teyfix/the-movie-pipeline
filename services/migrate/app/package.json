{
  "name": "migrate",
  "private": true,
  "scripts": {
    "generate": "run-s migrate:gen migrate:fmt",
    "migrate": "run-s migrate:gen migrate:fmt migrate:run",
    "migrate:fmt": "prettier --config .prettierrc --write drizzle",
    "migrate:gen": "drizzle-kit generate",
    "migrate:run": "drizzle-kit migrate"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.49",
    "drizzle-orm": "^1.0.0-rc.2",
    "env-var": "^7.5.0",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^1.0.0-rc.2",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.3",
    "prettier-plugin-embed": "^0.5.1",
    "prettier-plugin-packagejson": "^3.0.2",
    "prettier-plugin-sql": "^0.20.0",
    "typescript": "^6.0.3"
  }
}
