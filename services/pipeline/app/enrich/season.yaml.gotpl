{{- $tmdb := datasource "tmdb" }}
{{- $show := $tmdb.resources.show }}
{{- $season := $tmdb.extras.season }}

input:
  label: show
  redpanda:
    seed_brokers: ["${KAFKA_BROKERS}"]
    topics: ["{{ $show.topic.normalized }}"]
    consumer_group: "{{ $season.consumer.enrich }}"
    start_from_oldest: true
    fetch_max_bytes: 5mb
    fetch_max_partition_bytes: 5mb
    fetch_max_wait: 5s
    max_yield_batch_bytes: 5mb
    partition_buffer_bytes: 10mb
  processors:
    - mapping: |
        root = this.data.seasons.or([]).
          map_each(s -> this.
            without("data").
            assign({
              "data": this.data.
                with("id", "name", "original_name").
                assign({ "season": s })
            })
          )

    - unarchive:
        format: json_array

pipeline:
  processors:
    - label: "{{ $season.kind }}_meta"
      mapping: |
        meta output_topic = "{{ $season.topic.detail }}"
        meta output_id = this.data.season.id
        meta endpoint = "{{ $season.enrich.endpoint }}".
          format(this.data.id.string(), this.data.season.season_number.string())

    - branch:
        request_map: root = ""
        processors:
          - label: "api_{{ $season.kind }}"
            http:
              url: ${TMDB_API_URL}${! meta("endpoint") }
              verb: GET
              headers:
                Authorization: "Bearer ${TMDB_API_SECRET}"
              retries: 3
              successful_on: [200]
              drop_on: [404]
              extract_headers:
                include_prefixes: [X-Cache-Status]

          - switch:
              - check: '!["HIT", "STALE", "REVALIDATED", "UPDATING"].contains(meta("X-Cache-Status").or("MISS").uppercase())'
                processors:
                  - rate_limit:
                      resource: tmdb

        result_map: |
          root = {
            "data": this,
            "meta": {
              "v": 1,
              "ts": now(),
            },
            "source": root,
            "connect": @,
          }

    - catch:
        - resource: error_mapping

output:
  label: kafka
  redpanda:
    seed_brokers: ["${KAFKA_BROKERS}"]
    topic: '${! meta("output_topic") }'
    key: '${! meta("output_id") }'
    max_message_bytes: 100MB
    compression: zstd
