{{- $tmdb := datasource "tmdb" -}}
{{- $values := datasource "values" -}}

{{- $defaults := dict
    "group"    "resources"
    "kind"     (getenv "TEMPLATE_NAME")
    "topic"    "normalized"
    "consumer" "ingest"
    "schema"   (default "tmdb" (getenv "PG_SCHEMA"))
-}}

{{- $config := merge (default (dict) (index $values "config")) $defaults -}}
{{- $pipeline := $tmdb | coll.Index $config.group $config.kind -}}

input:
  label: kafka
  redpanda:
    seed_brokers: ["${KAFKA_BROKERS}"]
    topics: ["{{ index $pipeline.topic $config.topic }}"]
    consumer_group: "{{ index $pipeline.consumer $config.consumer }}"
    start_from_oldest: true
    partition_buffer_bytes: "{{ $pipeline.ingest.batch_size }}"
    max_yield_batch_bytes: "{{ $pipeline.ingest.batch_size }}"
  processors:
    - label: kafka_meta_{{ $config.kind }}
      mapping: |
        meta tmdb_id = this.data.id
        meta tmdb_kind = {{ $config.kind | quote}}
        meta tmdb_version = this.meta.ts

        root = this
        root.data.version_ts = this.meta.ts

output:
  broker:
    outputs:
{{- range $label, $stream := $values.streams }}
{{- $mappingDefaults := dict
  "from" (printf "pipelines/%s/%s.blobl" (getenv "TEMPLATE_NAME") $label)
  "unarchive" true
  "deduplicate" true
  "drop_error" false
}}
{{- $outputDefaults := dict
  "updated_at" false
}}
{{- $mapping := merge (default (dict) (index $stream "mapping")) $mappingDefaults }}
{{- $output := merge $stream.output $outputDefaults }}
{{- $columns := coll.Slice $output.primary $output.columns | flatten | uniq }}
      - label: {{ $label }}
        processors:
          - label: mapping_{{ $label }}
            mapping: from {{ $mapping.from | quote }}
          {{- if $mapping.unarchive }}

          - label: unarchive_{{ $label }}
            unarchive:
              format: json_array
          {{- end }}
          {{- if $mapping.drop_error }}

          - label: drop_error_{{ $label }}
            switch:
              - check: json("~error") != null
                processors:
                  - label: drop_error_log_{{ $label }}
                    log:
                      level: WARN
                      message: '${! json("~error.message").or("dropping the message with ~error field") }'
                      fields_mapping: root = this

                  - label: drop_error_deleted_{{ $label }}
                    mapping: root = deleted()
          {{- end }}
          {{- if $mapping.deduplicate }}

          - label: dedup_meta_{{ $label }}
            mapping: |
              root = this.assign({ "version_ts": this.version_ts.or(@tmdb_version) })

          - label: dedup_group_{{ $label }}
            group_by_value:
              value: '
                {{- range $i, $col := $output.primary -}}
                  {{- if $i -}}-{{ end -}}
                  ${! json("{{ $col }}") }
                {{- end -}}
              '

          - label: dedup_archive_{{ $label }}
            archive:
              format: json_array

          - label: dedup_sort_{{ $label }}
            mapping: |
              root = this.sort_by(e -> e.version_ts).index(-1)
          {{- end }}
        sql_insert:
          driver: pgx
          dsn: "${POSTGRES_URL}"
          table: '{{ $config.schema | quote }}.{{ $output.table | quote }}'
          columns:
          {{- range $col := $columns }}
            - '{{ $col | quote }}'
          {{- end }}
          args_mapping: |-
            root = [
              {{- range $col := $columns }}
                this.{{ $col }},
              {{- end }}
            ]
          suffix: |-
            ON CONFLICT (
              {{- range $idx, $col := $output.primary -}}
                {{- if $idx }}, {{ end -}}
                {{ $col | quote }}
              {{- end -}}
            ) DO UPDATE SET
              {{- $comma := false -}}
              {{- range $col := $columns }}
              {{- if not (has $output.primary $col) }}
              {{- if $comma }}, {{ end }}
              {{ $col | quote }} = EXCLUDED.{{ $col | quote }}
              {{- $comma = true -}}
              {{- end }}
              {{- end }}
              {{- if $output.updated_at }}
              {{- if $comma }}, {{ end }}
              "updated_ts" = now()
              {{- end }}
          max_in_flight: ${INGEST_MAX_IN_FLIGHT}
          conn_max_open: ${INGEST_CONN_MAX_OPEN}
          conn_max_idle: ${INGEST_CONN_MAX_IDLE}
          conn_max_life_time: ${INGEST_CONN_MAX_LIFE_TIME}
{{- end }}
