root = this.data.credits.with("cast", "crew").
  key_values().
  map_each(kv -> kv.value.
    map_each(c -> {
      "credit_id" : "00000000%s".format(c.credit_id),
      "person_id": c.id,
      "kind" : kv.key,
      "guest": false,
      "title_id": this.data.id,
      "title_kind": @tmdb_kind,
      "version_ts": this.meta.ts,
    })
  ).
  flatten()
