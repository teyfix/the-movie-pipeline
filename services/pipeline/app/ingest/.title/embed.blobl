let max_dimensions = env("EMBEDDING_DIMENSIONS_MAX").number()
let embedding = this.data.embedding.
  map_each(v -> v.number()).
  concat(
    range(0, $max_dimensions - this.data.embedding.length()).
    map_each(_ -> 0.0)
  ).
  vector()

root = {
  "title_id": this.source.data.id,
  "title_kind": @tmdb_kind,
  "model_id": this.data.model.id,
  "model_dimensions": this.data.model.dimensions,
  "input": this.data.overview,
  "embedding": $embedding,
  "version_ts": this.source.meta.ts,
}
