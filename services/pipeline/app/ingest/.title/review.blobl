root = this.data.reviews.
  map_each(r -> r.
    with(
      "author", "content", "url", "created_at", "updated_at",
      "author_avatar_path", "author_name", "author_rating", "author_username",
    ).
    assign({
      "id": "00000000%s".format(r.id),
      "title_id": this.data.id,
      "title_kind": @tmdb_kind,
      "version_ts": this.meta.ts,
    })
  )
