root = [].
  concat(
    this.data.production_companies.or([]).
      map_each(p -> {
        "title_id": this.data.id,
        "title_kind": @tmdb_kind,
        "company_id": p.id,
        "company_kind": "production_company",
        "version_ts": this.meta.ts,
      }),
    this.data.networks.or([]).
      map_each(n -> {
        "title_id": this.data.id,
        "title_kind": @tmdb_kind,
        "company_id": n.id,
        "company_kind": "tv_network",
        "version_ts": this.meta.ts,
      }),
  ).
  flatten()
