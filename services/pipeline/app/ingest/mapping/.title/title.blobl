root = this.data.
  with(
    "id",
    "original_language",
    "homepage",
    "overview",
    "tagline",
    "popularity",
    "release_date",
    "softcore",
    "status",
    "vote_average",
    "vote_count",
    "poster_path",
    "backdrop_path",
    "adult",
  ).
  assign({
    "kind": @tmdb_kind,
    "name": this.data.title.or(this.data.name),
    "original_name": this.data.original_title.or(this.data.original_name),
    "version_ts": this.meta.ts,
  })
