root = this.data.episodes.
  map_each(e -> e.guest_stars.
    map_each(c -> if c.id != null {
      c.
        with("cast_id", "order", "character").
        assign({
          "credit_id" : "00000000%s".format(c.credit_id),
          "version_ts": this.meta.ts,
        })
    } else {
      {
        "~error": {
          "message": "discarding invalid episode credit",
          "detail": {
            "kind": "cast",
            "title_id": e.id,
            "title_kind": "episode",
          },
          "payload": c,
        }
      }
    })
  ).
  flatten()
