{{- $tmdb := (datasource "tmdb") -}}

input:
  broker:
    inputs:
    {{- range merge $tmdb.resources $tmdb.extras }}
      - label: "{{ .kind }}"
        redpanda:
          seed_brokers: ["${KAFKA_BROKERS}"]
          topics: ["{{ .topic.detail }}"]
          consumer_group: "{{ .consumer.normalize }}"
          start_from_oldest: true
          partition_buffer_bytes: "{{ .ingest.batch_size }}"
          max_yield_batch_bytes: "{{ .ingest.batch_size }}"
        processors:
          - mapping: |
              meta output_id = this.data.id
              meta output_topic = "{{ .topic.normalized }}"
    {{- end }}

pipeline:
  processors:
    - label: unwrap
      mapping: from "pipelines/mapping/unwrap.blobl"
    - label: sanitize
      mapping: from "pipelines/mapping/sanitize.blobl"
    - catch:
      - mapping: |
          meta output_topic = meta("output_topic") + "-dlq"

          root = {
            "payload": this,
            "error": {
              "name": error_source_name(),
              "path": error_source_path(),
              "label": error_source_label(),
              "message": error(),
            },
            "meta": {
              "ts": now(),
              "tmdb_id": meta("tmdb_id"),
            },
          }

output:
  label: kafka
  redpanda:
    seed_brokers: ["${KAFKA_BROKERS}"]
    topic: '${! meta("output_topic") }'
    key: '${! meta("output_id") }'
    max_message_bytes: 100MB
    compression: zstd
    batching:
      count: 100
      period: 1s
