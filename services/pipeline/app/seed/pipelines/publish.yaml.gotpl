{{- $tmdb := datasource "tmdb" -}}

sources:
{{- range $tmdb.resources }}
  tmdb_file_{{ .kind }}:
    type: file
    include:
    {{- range $prefix := .download.prefix }}
      - "${TMDB_DOWNLOAD_DIR:?}/{{ $prefix }}_ids_*.json.gz"
    {{- end }}
    ignore_checkpoints: true
{{- end }}

transforms:
{{- range $tmdb.resources }}
  tmdb_envelope_{{ .kind }}:
    type: remap
    inputs:
      - tmdb_file_{{ .kind }}*
    source: |
      parsed = parse_json!(.message)
      del(.message)
      . = {
        "data": parsed,
        "vector": .,
        "meta": {
          "v": 1,
          "ts": now(),
          "topic": "{{ .topic.export }}",
        }
      }
{{- end }}

sinks:
  tmdb_publish_redpanda:
    type: kafka
    inputs:
      - tmdb_envelope_*
    bootstrap_servers: "${KAFKA_BROKERS}"
    topic: '{{ `{{ meta.topic }}` }}'
    key_field: data.id
    encoding:
      codec: json
    acknowledgements:
      enabled: true
    compression: zstd
